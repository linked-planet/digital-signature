<toolchains>
    <!-- JDK 21: setup-java and the Nix flake both export JAVA_HOME -->
    <toolchain>
        <type>jdk</type>
        <provides>
            <version>21</version>
            <vendor>eclipse-temurin</vendor>
        </provides>
        <configuration>
            <jdkHome>${env.JAVA_HOME}</jdkHome>
        </configuration>
    </toolchain>
</toolchains>
